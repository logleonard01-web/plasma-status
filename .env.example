# =============================================================================
# PlasmaStatus — Environment Variables
# =============================================================================
# Copy this file to .env for local development, or add each variable in the
# Vercel dashboard under Project → Settings → Environment Variables.
#
# Vercel auto-sets VERCEL=1, so the app knows it's running serverless.
# Environment variables ALWAYS take priority over config.yml values.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — the app will not start without these
# -----------------------------------------------------------------------------

# MongoDB Atlas connection string
# Free cluster at https://cloud.mongodb.com
# ⚠️  Allow network access from 0.0.0.0/0 in Atlas (Vercel uses dynamic IPs)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/plasmastatus?retryWrites=true&w=majority

# Discord OAuth2 credentials (from https://discord.com/developers/applications)
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Your deployed URL — no trailing slash
BASE_URL=https://your-project-name.vercel.app

# Discord OAuth2 callback — must match exactly what you set in the Developer Portal
DISCORD_CALLBACK_URL=https://your-project-name.vercel.app/auth/discord/callback

# Discord User IDs allowed in the staff dashboard
# Comma-separated for multiple: "123456789012345678,987654321098765432"
OWNER_IDS=YOUR_DISCORD_USER_ID

# Random secret for signing session cookies (32+ chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change_me_to_a_long_random_secret_string

# -----------------------------------------------------------------------------
# DISCORD SLASH COMMANDS (Interactions API — no cron jobs required)
# -----------------------------------------------------------------------------

# Ed25519 Public Key from your Discord application's General Information page
# (NOT the bot token — this is the "Public Key" field on the app page)
DISCORD_PUBLIC_KEY=your_discord_application_public_key_here

# Discord Bot Token — needed to register slash commands AND for the bot embed feature
# Create a bot at https://discord.com/developers/applications → Bot
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# For instant slash command registration (optional — leave blank to register globally)
# Global commands take up to 1 hour to appear; guild commands are instant
DISCORD_GUILD_ID=

# -----------------------------------------------------------------------------
# OPTIONAL
# -----------------------------------------------------------------------------

# How stale (in milliseconds) status data can be before a page load triggers
# a fresh check. Default: 300000 (5 minutes). Lower = more up-to-date but
# slower page loads. Minimum recommended: 60000 (1 minute).
STALE_THRESHOLD_MS=300000

# Set to "true" if served over HTTPS (always true on Vercel — set automatically)
SECURE=true

# Session expiry (e.g. 7d, 24h, 30m). Default: 7d
SESSION_EXPIRES=7d

# Set to "true" for verbose debug logging
DEBUG_MODE=false

# Number of reverse proxies in front of the app (for correct IP detection)
# Keep at 1 for Vercel (Vercel's load balancer is the proxy)
TRUST_PROXY=1

