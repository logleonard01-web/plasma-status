<!DOCTYPE html>
<%
  // Theme is configurable in config.yml -> PageSettings.Theme ("simple" | "professional").
  var theme = String((config.PageSettings && config.PageSettings.Theme) || 'simple').toLowerCase();
  if (theme !== 'simple' && theme !== 'professional') theme = 'simple';

  // Safe to embed in an inline script: escapes the characters that could break
  // out of the script context (e.g. a service name or announcement that contains
  // a closing script tag). split/join avoids regex literals, which the template
  // compiler mis-parses inside this block.
  function jsonForScript(obj) {
    return JSON.stringify(obj === undefined ? null : obj)
      .split('<').join('\\u003c')
      .split('>').join('\\u003e')
      .split('&').join('\\u0026')
      .split(' ').join('\\u2028')
      .split(' ').join('\\u2029');
  }
%>
<html lang="en" data-theme="<%= theme %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= config.PageSettings.Name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <script defer src="https://unpkg.com/alpinejs@3.13.3/dist/cdn.min.js"></script>

  <meta property="og:title" content="<%= config.PageSettings.Name %>" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= config.PageSettings.baseURL %>" />
  <meta property="og:image" content="<%= config.PageSettings.baseURL %>/logo.png" />
  <meta property="og:description" content="<%= config.PageSettings.Description %>" />
  <meta name="theme-color" content="<%= config.PageSettings.ThemeColor %>">

  <link rel="stylesheet" href="/css/status-<%= theme %>.css">
  <style>:root { --primary: <%= config.PageSettings.ThemeColor %>; --primary-rgb: <%= themeColorRgb %>; }</style>
</head>

<body x-data="statusPage()" x-init="init()" x-cloak>

  <!-- Announcement -->
  <template x-if="announcement.enabled && announcement.show">
    <div :class="`announcement announcement--${announcement.type}`" x-transition.opacity.duration.400ms>
      <span class="announcement__icon"><i :class="getAnnouncementIcon()"></i></span>
      <span class="announcement__msg" x-text="announcement.message"></span>
      <template x-if="announcement.dismissible">
        <button class="announcement__close" @click="dismissAnnouncement()" title="Dismiss" aria-label="Dismiss">
          <i class="fas fa-times"></i>
        </button>
      </template>
    </div>
  </template>

  <% if (theme === 'professional') { %>
  <header class="appbar">
    <div class="container appbar__inner">
      <a href="/" class="appbar__brand">
        <img class="appbar__logo" src="/logo.png" alt="<%= config.PageSettings.Name %>">
        <span class="appbar__name"><%= config.PageSettings.Name %></span>
      </a>
      <nav class="appbar__nav">
        <button type="button" class="refresh-link" :class="{ 'is-spinning': isRefreshing }" :disabled="isRefreshing" @click="refreshStatus()" title="Refresh status" aria-label="Refresh status"><i class="fas fa-rotate-right"></i><span x-text="isRefreshing ? 'Refreshing' : 'Refresh'"></span></button>
        <a href="/dashboard" class="footer-link"><%= (typeof isStaff !== 'undefined' && isStaff) ? 'Staff dashboard' : 'Staff login' %></a>
      </nav>
    </div>
  </header>
  <% } else { %>
  <header class="topbar">
    <div class="container topbar__inner">
      <a href="/" class="topbar__brand">
        <img class="topbar__logo" src="/logo.png" alt="<%= config.PageSettings.Name %>">
        <span class="topbar__name"><%= config.PageSettings.Name %></span>
      </a>
      <nav class="topbar__nav">
        <input type="search" class="search" x-model="query" placeholder="Search services" aria-label="Search services">
        <button type="button" class="refresh-link" :class="{ 'is-spinning': isRefreshing }" :disabled="isRefreshing" @click="refreshStatus()" title="Refresh status" aria-label="Refresh status"><i class="fas fa-rotate-right"></i><span x-text="isRefreshing ? 'Refreshing' : 'Refresh'"></span></button>
        <a href="/dashboard" class="footer-link"><%= (typeof isStaff !== 'undefined' && isStaff) ? 'Dashboard' : 'Staff login' %></a>
      </nav>
    </div>
  </header>
  <% } %>

  <main class="page">
    <div class="container">

    <% if (theme === 'professional') { %>
      <!-- Overall status -->
      <section class="banner" :class="overallStatusClass">
        <i class="banner__icon" :class="overallStatusClass === 'online' ? 'fas fa-check' : (overallStatusClass === 'offline' ? 'fas fa-xmark' : 'fas fa-exclamation')"></i>
        <h1 class="banner__title" x-html="getColoredStatusText()"></h1>
      </section>

      <div class="toolbar">
        <div>
          <h2 class="toolbar__title">Current status</h2>
          <p class="toolbar__sub" x-text="`${stats[0].value} of ${stats[3].value} online · ${stats[1].value} uptime over 90 days · ${stats[2].value} average response`"></p>
        </div>
        <input type="search" class="search" x-model="query" placeholder="Filter components" aria-label="Filter components">
      </div>
    <% } else { %>
      <!-- Overall status -->
      <section class="statusbar" :class="overallStatusClass">
        <span class="statusbar__dot"></span>
        <h1 class="statusbar__title" x-html="getColoredStatusText()"></h1>
        <span class="statusbar__meta" x-text="services.filter(s => s.status === 'online').length + ' of ' + services.length + ' up'"></span>
      </section>
    <% } %>

      <!-- Services by category -->
      <section class="services">
        <p class="services__empty" x-show="query && !Object.keys(servicesByCategory).length">No services match "<span x-text="query"></span>".</p>
        <template x-for="[categoryName, categoryServices] in Object.entries(servicesByCategory)" :key="categoryName">
          <div class="category">
            <div class="category__head">
              <h2 class="category__name" x-text="categoryName"></h2>
              <span class="category__count" x-text="categoryServices.filter(s => s.status === 'online').length + '/' + categoryServices.length + ' operational'"></span>
            </div>

            <div class="category__list">
              <template x-for="service in categoryServices" :key="service.name">
                <article class="service" :class="service.status">
                  <div class="service__row">
                    <div class="service__id">
                      <span class="service__dot" :class="service.status"></span>
                      <span class="service__name" x-text="service.name"></span>
                    </div>
                    <div class="service__stats">
                      <span class="metric metric--uptime">
                        <span class="metric__value" x-text="`${service.uptimePercentage}%`"></span>
                        <span class="metric__label">uptime</span>
                      </span>
                      <span class="metric metric--resp">
                        <span class="metric__value" x-text="(service.status === 'offline' || service.status === 'maintenance') ? '—' : (service.responseTime ? `${service.responseTime}ms` : '—')"></span>
                        <span class="metric__label">response</span>
                      </span>
                      <span class="service__badge" :class="service.status"
                        x-text="({ online: 'Operational', partial: 'Degraded', offline: 'Outage', maintenance: 'Maintenance' })[service.status] || service.status"></span>
                    </div>
                  </div>

                  <!-- 90-day history -->
                  <div class="history">
                    <div class="history__bars">
                      <template x-for="(day, index) in service.history" :key="index">
                        <div class="bar" :class="day.status">
                          <div class="tooltip">
                            <div class="tooltip__head">
                              <span class="tooltip__dot" :class="day.status"></span>
                              <span class="tooltip__date" x-text="day.date !== 'N/A' ? formatDate(day.date) : 'No data'"></span>
                            </div>
                            <div class="tooltip__row">
                              <span class="tooltip__label">Status</span>
                              <span class="tooltip__value" x-text="day.status === 'placeholder' ? 'Unknown' : day.status.charAt(0).toUpperCase() + day.status.slice(1)"></span>
                            </div>
                            <template x-if="day.date !== 'N/A'">
                              <div>
                                <div class="tooltip__row">
                                  <span class="tooltip__label">Uptime</span>
                                  <span class="tooltip__value" x-text="`${day.uptimePercentage || '100'}%`"></span>
                                </div>
                                <template x-if="day.durations && day.durations.length > 0">
                                  <div class="tooltip__row">
                                    <span class="tooltip__label">Downtime</span>
                                    <span class="tooltip__value" x-text="formatDowntime(day.durations)"></span>
                                  </div>
                                </template>
                                <template x-if="(day.status === 'online' || day.status === 'partial') && day.avgResponseTime">
                                  <div class="tooltip__row">
                                    <span class="tooltip__label">Response</span>
                                    <span class="tooltip__value" x-text="`${day.avgResponseTime}ms`"></span>
                                  </div>
                                </template>
                              </div>
                            </template>
                          </div>
                        </div>
                      </template>
                    </div>
                    <div class="history__axis">
                      <span>90 days ago</span>
                      <span x-text="`${service.uptimePercentage}% uptime`"></span>
                      <span>Today</span>
                    </div>
                  </div>
                </article>
              </template>
            </div>
          </div>
        </template>
      </section>

    </div>
  </main>

  <footer class="sitefoot">
    <div class="container sitefoot__inner">
      <%= config.PageSettings.Name %> · updated <span x-text="getRelativeTime(lastUpdated)"></span>
    </div>
  </footer>

  <!-- Toast -->
  <div class="toast" :class="{ 'is-shown': toast.show }" x-show="toast.show" x-transition.opacity>
    <div class="toast__head">
      <span class="toast__icon"><i class="fas fa-info"></i></span>
      <span class="toast__title" x-text="toast.title"></span>
    </div>
    <div class="toast__msg" x-text="toast.message"></div>
  </div>

  <script>
    window.statusPageData = {
      services: <%- jsonForScript(services) %>,
      lastUpdated: '<%= lastUpdated %>',
      overallStatusText: '<%= overallStatus %>',
      overallStatusClass: '<%= statusClass %>',
      config: {
        name: <%- jsonForScript(config.PageSettings.Name) %>,
        logo: '/logo.png',
        announcement: <%- jsonForScript(config.Announcement || null) %>
      }
    };

    function statusPage() {
      return {
        services: window.statusPageData.services,
        lastUpdated: window.statusPageData.lastUpdated,
        overallStatusText: window.statusPageData.overallStatusText,
        overallStatusClass: window.statusPageData.overallStatusClass,

        isRefreshing: false,
        query: '',
        toast: { show: false, title: '', message: '' },
        announcement: { show: true, enabled: false, message: '', type: 'info', dismissible: true },

        get servicesByCategory() {
          const q = this.query.trim().toLowerCase();
          return this.services.filter(s => !q || s.name.toLowerCase().includes(q)).reduce((categories, service) => {
            const category = service.category || 'Uncategorized';
            (categories[category] = categories[category] || []).push(service);
            return categories;
          }, {});
        },

        get stats() {
          const onlineServices = this.services.filter(s => s.status === 'online').length;
          const totalUptime = this.services.reduce((sum, s) => sum + parseFloat(s.uptimePercentage || 0), 0);
          const avgUptime = this.services.length ? (totalUptime / this.services.length).toFixed(1) : 0;
          const responseTimes = this.services.filter(s => s.responseTime > 0 && s.status === 'online');
          const avgResponse = responseTimes.length ?
            Math.round(responseTimes.reduce((sum, s) => sum + s.responseTime, 0) / responseTimes.length) : 0;

          return [
            { value: onlineServices, label: 'Services Online' },
            { value: `${avgUptime}%`, label: 'Overall Uptime' },
            { value: `${avgResponse}ms`, label: 'Avg Response' },
            { value: this.services.length, label: 'Total Services' }
          ];
        },

        init() {
          this.initAnnouncement();
          this.startRelativeTimeUpdater();
        },

        initAnnouncement() {
          const config = window.statusPageData.config;
          if (config.announcement) {
            this.announcement.enabled = config.announcement.Enabled;
            this.announcement.message = config.announcement.Message;
            this.announcement.type = config.announcement.Type || 'info';
            this.announcement.dismissible = config.announcement.Dismissible !== false;
            if (this.announcement.dismissible) {
              try {
                const dismissedKey = `announcement-dismissed-${this.hashString(this.announcement.message)}`;
                this.announcement.show = !localStorage.getItem(dismissedKey);
              } catch (e) { /* storage unavailable */ }
            }
          }
        },

        hashString(str) {
          let hash = 0;
          for (let i = 0; i < str.length; i++) {
            hash = ((hash << 5) - hash) + str.charCodeAt(i);
            hash = hash & hash;
          }
          return Math.abs(hash).toString();
        },

        dismissAnnouncement() {
          try {
            const dismissedKey = `announcement-dismissed-${this.hashString(this.announcement.message)}`;
            localStorage.setItem(dismissedKey, 'true');
          } catch (e) { /* storage unavailable */ }
          this.announcement.show = false;
        },

        getAnnouncementIcon() {
          const icons = { info: 'fas fa-circle-info', warning: 'fas fa-triangle-exclamation', success: 'fas fa-circle-check', error: 'fas fa-circle-exclamation' };
          return icons[this.announcement.type] || icons.info;
        },

        async refreshStatus() {
          if (this.isRefreshing) return;
          try {
            this.isRefreshing = true;
            const response = await fetch('/refresh');
            const data = await response.json();
            if (data.lastUpdated) {
              this.lastUpdated = data.lastUpdated;
              this.showToast('Status updated', 'Service statuses have been refreshed.');
              setTimeout(() => window.location.reload(), 1000);
            }
          } catch (error) {
            console.error('Error refreshing status:', error);
            this.showToast('Refresh failed', 'There was an error refreshing the status. Please try again.');
          } finally {
            this.isRefreshing = false;
          }
        },

        showToast(title, message) {
          this.toast.title = title;
          this.toast.message = message;
          this.toast.show = true;
          setTimeout(() => { this.toast.show = false; }, 5000);
        },

        getColoredStatusText() {
          const statusKeywords = {
            online: ['online', 'operational'],
            offline: ['offline', 'down'],
            partial: ['partial', 'degraded'],
            maintenance: ['maintenance', 'scheduled']
          };
          let coloredText = this.overallStatusText;
          Object.keys(statusKeywords).forEach(status => {
            statusKeywords[status].forEach(keyword => {
              const regex = new RegExp(`\\b(${keyword})\\b`, 'gi');
              coloredText = coloredText.replace(regex, `<span class="kw ${status}">$1</span>`);
            });
          });
          return coloredText;
        },

        getRelativeTime(timestamp) {
          const diff = new Date().getTime() - new Date(timestamp).getTime();
          const minute = 60 * 1000, hour = 60 * minute, day = 24 * hour;
          if (diff < minute) return 'just now';
          if (diff < hour) { const m = Math.floor(diff / minute); return `${m} minute${m > 1 ? 's' : ''} ago`; }
          if (diff < day) { const h = Math.floor(diff / hour); return `${h} hour${h > 1 ? 's' : ''} ago`; }
          const d = Math.floor(diff / day); return `${d} day${d > 1 ? 's' : ''} ago`;
        },

        formatDowntime(durations) {
          if (!durations || durations.length === 0) return 'None';
          const totalSeconds = durations.reduce((sum, d) => sum + d, 0);
          if (totalSeconds < 60) return `${Math.round(totalSeconds)}s`;
          if (totalSeconds < 3600) return `${Math.round(totalSeconds / 60)}m`;
          return `${Math.round(totalSeconds / 3600)}h`;
        },

        formatDate(dateStr) {
          if (dateStr === 'N/A') return 'No data';
          return new Date(dateStr).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
        },

        startRelativeTimeUpdater() {
          setInterval(() => { this.$nextTick(); }, 60000);
        }
      };
    }
  </script>
</body>

</html>
